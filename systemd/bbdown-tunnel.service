[Unit]
Description=BBDown Cloudflare Public Tunnel
After=network.target bbdown.service

[Service]
Type=simple
User=openarmx
WorkingDirectory=/home/openarmx/BBDown
ExecStart=/usr/bin/python3 /home/openarmx/BBDown/start_tunnel.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
